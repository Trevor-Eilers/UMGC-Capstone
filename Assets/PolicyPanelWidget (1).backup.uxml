<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Resources/GameHUD.uss?fileID=7433441132597879392&amp;guid=7bc2dafd71b614848a143c8754ca89c1&amp;type=3#GameHUD"/>
    <ui:VisualElement name="VisualElement" style="flex-grow: 0; width: 250px; flex-shrink: 0; flex-direction: column; align-items: stretch; background-color: rgba(17, 17, 24, 0.98); border-left-width: 1px; border-left-color: rgba(255, 255, 255, 0.08); padding-left: 24px; padding-right: 24px; padding-top: 24px; padding-bottom: 24px; min-width: auto; border-top-left-radius: 32px; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 32px; justify-content: flex-start; align-content: auto;">
        <ui:Label text="Policies" style="color: rgb(255, 255, 255); font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 4px; padding-bottom: 8px;"/>
        <ui:VisualElement name="Divider" style="flex-grow: 0; padding-top: 0; padding-bottom: 0; margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>
        <ui:VisualElement name="TaxRow">
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between; margin-top: 2px; margin-bottom: 2px;">
                <ui:Label text="Tax Rate" style="font-size: 12px; color: rgba(255, 255, 255, 0.6); -unity-text-align: middle-left; -unity-font-style: normal; margin: 0; padding: 0;"/>
                <ui:Label text="i" name="TaxInfo" tooltip="How much you tax residents (5-30%). Higher rates bring in more revenue but residents get unhappy and the economy grows slower." style="width: 14px; height: 14px; font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.75); background-color: rgba(255, 255, 255, 0.08); border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-left-radius: 7px; border-bottom-right-radius: 7px; margin: 0; padding: 0;"/>
            </ui:VisualElement>
            <ui:Slider label="" value="15" high-value="30" name="TaxSlider" show-input-field="true" direction="Horizontal" fill="true" low-value="5" inverted="false" style="width: 100%; margin-left: 0; margin-right: 0; margin-bottom: 2px; flex-shrink: 0; scale: 1 0.8; flex-direction: row;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="flex-grow: 0; padding-top: 0; padding-bottom: 0; margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>
        <ui:VisualElement name="EduRow">
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between; margin-top: 2px; margin-bottom: 2px;">
                <ui:Label text="Education" style="font-size: 12px; color: rgba(255, 255, 255, 0.6); -unity-text-align: middle-left; -unity-font-style: normal; margin: 0; padding: 0;"/>
                <ui:Label text="i" name="EduInfo" tooltip="Spending on schools and workforce training. The single biggest driver of GDP growth. Cut it and your economy stagnates." style="width: 14px; height: 14px; font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.75); background-color: rgba(255, 255, 255, 0.08); border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-left-radius: 7px; border-bottom-right-radius: 7px; margin: 0; padding: 0;"/>
            </ui:VisualElement>
            <ui:Slider label="" value="50" high-value="100" name="EduSlider" show-input-field="false" direction="Horizontal" fill="true" style="width: 100%; margin-left: 0; margin-right: 0; margin-bottom: 2px; flex-shrink: 0; scale: 1 0.8;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="flex-grow: 0; padding-top: 0; padding-bottom: 0; margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>
        <ui:VisualElement name="InfraRow">
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between; margin-top: 2px; margin-bottom: 2px;">
                <ui:Label text="Infrastructure" style="font-size: 12px; color: rgba(255, 255, 255, 0.6); -unity-text-align: middle-left; -unity-font-style: normal; margin: 0; padding: 0;"/>
                <ui:Label text="i" name="InfraInfo" tooltip="Spending on roads, utilities, and public works. Builds up your Infrastructure metric, which supports GDP and sustainability. Decays every tick without upkeep." style="width: 14px; height: 14px; font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.75); background-color: rgba(255, 255, 255, 0.08); border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-left-radius: 7px; border-bottom-right-radius: 7px; margin: 0; padding: 0;"/>
            </ui:VisualElement>
            <ui:Slider label="" value="50" high-value="100" name="InfraSlider" show-input-field="false" direction="Horizontal" fill="true" style="width: 100%; margin-left: 0; margin-right: 0; margin-bottom: 2px; flex-shrink: 0; scale: 1 0.8;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="flex-grow: 0; padding-top: 0; padding-bottom: 0; margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>
        <ui:VisualElement name="HousingRow">
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between; margin-top: 2px; margin-bottom: 2px;">
                <ui:Label text="Housing" style="font-size: 12px; color: rgba(255, 255, 255, 0.6); -unity-text-align: middle-left; -unity-font-style: normal; margin: 0; padding: 0;"/>
                <ui:Label text="i" name="HousingInfo" tooltip="Spending on residential amenities. The direct dial for happiness, and the biggest factor in whether new residents pick your district when they move in." style="width: 14px; height: 14px; font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.75); background-color: rgba(255, 255, 255, 0.08); border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-left-radius: 7px; border-bottom-right-radius: 7px; margin: 0; padding: 0;"/>
            </ui:VisualElement>
            <ui:Slider label="" value="50" high-value="100" name="HousingSlider" show-input-field="false" direction="Horizontal" fill="true" style="width: 100%; margin-left: 0; margin-right: 0; margin-bottom: 2px; flex-shrink: 0; scale: 1 0.8;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="flex-grow: 0; padding-top: 0; padding-bottom: 0; margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>
        <ui:VisualElement name="EnvRow">
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between; margin-top: 2px; margin-bottom: 2px;">
                <ui:Label text="Environment" style="font-size: 12px; color: rgba(255, 255, 255, 0.6); -unity-text-align: middle-left; -unity-font-style: normal; margin: 0; padding: 0;"/>
                <ui:Label text="i" name="EnvInfo" tooltip="Spending on pollution control and environmental regulation. Supports long-term sustainability. Drop below 30% with a strong economy and pollution starts spreading to your neighbors." style="width: 14px; height: 14px; font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.75); background-color: rgba(255, 255, 255, 0.08); border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-left-radius: 7px; border-bottom-right-radius: 7px; margin: 0; padding: 0;"/>
            </ui:VisualElement>
            <ui:Slider label="" value="50" high-value="100" name="EnvSlider" show-input-field="false" direction="Horizontal" fill="true" style="width: 100%; margin-left: 0; margin-right: 0; margin-bottom: 2px; flex-shrink: 0; scale: 1 0.8;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="flex-grow: 0; padding-top: 0; padding-bottom: 0; margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>
        <ui:VisualElement name="CityRow">
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between; margin-top: 2px; margin-bottom: 2px;">
                <ui:Label text="City Contribution" style="font-size: 12px; color: rgba(255, 255, 255, 0.6); -unity-text-align: middle-left; -unity-font-style: normal; margin: 0; padding: 0;"/>
                <ui:Label text="i" name="CityInfo" tooltip="How much you chip into shared metro projects (transit, highways, public facilities). The whole city benefits, not just you. Needed for cross-district commuting to work." style="width: 14px; height: 14px; font-size: 9px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgba(255, 255, 255, 0.75); background-color: rgba(255, 255, 255, 0.08); border-top-left-radius: 7px; border-top-right-radius: 7px; border-bottom-left-radius: 7px; border-bottom-right-radius: 7px; margin: 0; padding: 0;"/>
            </ui:VisualElement>
            <ui:Slider label="" value="25" high-value="50" name="CitySlider" show-input-field="false" direction="Horizontal" fill="true" style="width: 100%; margin-left: 0; margin-right: 0; flex-shrink: 0; scale: 1 0.8;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="flex-grow: 0; padding-top: 0; padding-bottom: 0; margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>
    </ui:VisualElement>
</ui:UXML>
