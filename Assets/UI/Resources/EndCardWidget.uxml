<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Resources/GameHUD.uss?fileID=7433441132597879392&amp;guid=7bc2dafd71b614848a143c8754ca89c1&amp;type=3#GameHUD"/>
    <ui:VisualElement name="EndCardOverlay" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(8, 8, 14); align-items: center; justify-content: center; display: none;">
        <ui:VisualElement name="EndCardPanel" style="width: 600px; background-color: rgb(23, 23, 32); border-left-color: rgb(64, 64, 77); border-right-color: rgb(64, 64, 77); border-top-color: rgb(64, 64, 77); border-bottom-color: rgb(64, 64, 77); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; padding-top: 28px; padding-right: 32px; padding-bottom: 24px; padding-left: 32px;">
            <ui:Label text="GAME OVER" style="color: rgb(120, 220, 120); font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-center; letter-spacing: 2px; margin-bottom: 2px;"/>
            <ui:Label text="48 months complete" style="color: rgba(180, 180, 180, 0.7); font-size: 11px; -unity-text-align: middle-center; margin-bottom: 24px;"/>
            <ui:VisualElement style="flex-direction: column; align-items: center; margin-bottom: 18px; padding-top: 18px; padding-bottom: 18px; background-color: rgb(16, 16, 24); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px;">
                <ui:Label text="FINAL SCORE" style="color: rgba(180, 180, 180, 0.65); font-size: 10px; -unity-font-style: bold; letter-spacing: 2px; -unity-text-align: middle-center; margin-bottom: 4px;"/>
                <ui:Label text="--" name="EndCardFinalScore" style="color: rgb(120, 220, 120); font-size: 64px; -unity-font-style: bold; -unity-text-align: middle-center;"/>
                <ui:Label text="" name="EndCardGrade" style="color: rgb(220, 220, 220); font-size: 14px; -unity-font-style: bold; letter-spacing: 3px; -unity-text-align: middle-center; margin-top: 6px;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; margin-bottom: 18px;">
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; padding-top: 12px; padding-bottom: 12px; padding-left: 14px; padding-right: 14px; background-color: rgb(19, 19, 28); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; margin-right: 6px;">
                    <ui:Label text="NEIGHBORHOOD" style="color: rgba(180, 180, 180, 0.6); font-size: 9px; -unity-font-style: bold; letter-spacing: 1px;"/>
                    <ui:VisualElement style="flex-direction: row; align-items: flex-end; margin-top: 2px;">
                        <ui:Label text="--" name="EndCardNeighborhoodScore" style="color: rgb(230, 230, 230); font-size: 24px; -unity-font-style: bold;"/>
                        <ui:Label text=" / 100" style="color: rgba(180, 180, 180, 0.5); font-size: 10px; margin-bottom: 4px;"/>
                    </ui:VisualElement>
                    <ui:Label text="60% of your final score" style="color: rgba(180, 180, 180, 0.8); font-size: 10px; -unity-font-style: bold; margin-top: 8px;"/>
                    <ui:Label text="Weighted average of your district&apos;s own metrics: GDP, happiness, population growth, infrastructure, sustainability, and fiscal discipline." style="color: rgba(180, 180, 180, 0.6); font-size: 10px; white-space: normal; margin-top: 4px;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; padding-top: 12px; padding-bottom: 12px; padding-left: 14px; padding-right: 14px; background-color: rgb(19, 19, 28); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; margin-left: 6px;">
                    <ui:Label text="CITY CONTRIBUTION" style="color: rgba(180, 180, 180, 0.6); font-size: 9px; -unity-font-style: bold; letter-spacing: 1px;"/>
                    <ui:VisualElement style="flex-direction: row; align-items: flex-end; margin-top: 2px;">
                        <ui:Label text="--" name="EndCardCityScore" style="color: rgb(230, 230, 230); font-size: 24px; -unity-font-style: bold;"/>
                        <ui:Label text=" / 100" style="color: rgba(180, 180, 180, 0.5); font-size: 10px; margin-bottom: 4px;"/>
                    </ui:VisualElement>
                    <ui:Label text="40% of your final score" style="color: rgba(180, 180, 180, 0.8); font-size: 10px; -unity-font-style: bold; margin-top: 8px;"/>
                    <ui:Label text="Combines city-wide reputation, your share of shared-infrastructure funding, and how well you avoided debt or happiness crises." style="color: rgba(180, 180, 180, 0.6); font-size: 10px; white-space: normal; margin-top: 4px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="YOUR DISTRICT" style="color: rgba(180, 180, 180, 0.6); font-size: 10px; -unity-font-style: bold; letter-spacing: 2px; margin-bottom: 8px;"/>
            <ui:VisualElement style="flex-direction: row; margin-bottom: 6px;">
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; padding-top: 8px; padding-bottom: 8px; padding-left: 10px; padding-right: 10px; background-color: rgb(19, 19, 28); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; margin-right: 3px;">
                    <ui:Label text="GDP" style="color: rgba(180, 180, 180, 0.55); font-size: 9px; -unity-font-style: bold;"/>
                    <ui:Label text="--" name="EndCardStatGDP" style="color: rgb(230, 230, 230); font-size: 16px; -unity-font-style: bold;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; padding-top: 8px; padding-bottom: 8px; padding-left: 10px; padding-right: 10px; background-color: rgb(19, 19, 28); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; margin-left: 3px; margin-right: 3px;">
                    <ui:Label text="HAPPINESS" style="color: rgba(180, 180, 180, 0.55); font-size: 9px; -unity-font-style: bold;"/>
                    <ui:Label text="--" name="EndCardStatHappy" style="color: rgb(230, 230, 230); font-size: 16px; -unity-font-style: bold;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; padding-top: 8px; padding-bottom: 8px; padding-left: 10px; padding-right: 10px; background-color: rgb(19, 19, 28); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; margin-left: 3px;">
                    <ui:Label text="POPULATION" style="color: rgba(180, 180, 180, 0.55); font-size: 9px; -unity-font-style: bold;"/>
                    <ui:Label text="--" name="EndCardStatPop" style="color: rgb(230, 230, 230); font-size: 16px; -unity-font-style: bold;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; margin-bottom: 12px;">
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; padding-top: 8px; padding-bottom: 8px; padding-left: 10px; padding-right: 10px; background-color: rgb(19, 19, 28); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; margin-right: 3px;">
                    <ui:Label text="INFRASTRUCTURE" style="color: rgba(180, 180, 180, 0.55); font-size: 9px; -unity-font-style: bold;"/>
                    <ui:Label text="--" name="EndCardStatInfra" style="color: rgb(230, 230, 230); font-size: 16px; -unity-font-style: bold;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; padding-top: 8px; padding-bottom: 8px; padding-left: 10px; padding-right: 10px; background-color: rgb(19, 19, 28); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; margin-left: 3px; margin-right: 3px;">
                    <ui:Label text="SUSTAINABILITY" style="color: rgba(180, 180, 180, 0.55); font-size: 9px; -unity-font-style: bold;"/>
                    <ui:Label text="--" name="EndCardStatSust" style="color: rgb(230, 230, 230); font-size: 16px; -unity-font-style: bold;"/>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-basis: 0; padding-top: 8px; padding-bottom: 8px; padding-left: 10px; padding-right: 10px; background-color: rgb(19, 19, 28); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; margin-left: 3px;">
                    <ui:Label text="DEBT" style="color: rgba(180, 180, 180, 0.55); font-size: 9px; -unity-font-style: bold;"/>
                    <ui:Label text="--" name="EndCardStatDebt" style="color: rgb(230, 230, 230); font-size: 16px; -unity-font-style: bold;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; padding-top: 10px; padding-bottom: 10px; padding-left: 14px; padding-right: 14px; background-color: rgb(19, 19, 28); border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; margin-bottom: 20px;">
                <ui:Label text="Crisis-free ticks" style="color: rgba(220, 220, 220, 0.85); font-size: 11px;"/>
                <ui:Label text="--" name="EndCardCrisisFree" style="color: rgb(230, 230, 230); font-size: 13px; -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:Button text="Return to Menu" name="EndCardReturnBtn" style="height: 42px; background-color: rgb(48, 128, 48); color: rgb(240, 240, 240); font-size: 14px; -unity-font-style: bold; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
