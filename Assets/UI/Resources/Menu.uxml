<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement enabled="true" style="flex-grow: 1; background-color: rgb(15, 20, 40); justify-content: flex-start; visibility: visible;">
        <ui:VisualElement name="TitleElement" style="flex-grow: 0; height: 40%; justify-content: center; align-items: center;">
            <ui:Label text="Civic Engine" name="Label" style="-unity-text-align: upper-center; font-size: 42px; -unity-font-style: bold; color: rgb(255, 255, 255); margin-bottom: 8px; letter-spacing: 3px;"/>
            <ui:Label text="City Economy Simulator" style="-unity-text-align: upper-center; font-size: 14px; color: rgba(255, 255, 255, 0.45); letter-spacing: 2px;"/>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 0; align-items: center; margin-bottom: 12px;">
            <ui:TextField label="Display Name" placeholder-text="Enter your name" name="DisplayNameField" value="player" style="width: 340px; margin-bottom: 10px; background-color: rgba(255, 255, 255, 0.06); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(255, 255, 255, 0.15); border-right-color: rgba(255, 255, 255, 0.15); border-top-color: rgba(255, 255, 255, 0.15); border-bottom-color: rgba(255, 255, 255, 0.15); color: rgb(137, 137, 137); font-size: 14px; padding-left: 12px; padding-right: 12px; padding-top: 10px; padding-bottom: 10px;"/>
            <ui:TextField label="Lobby ID" placeholder-text="Enter lobby ID" name="SessionNameField" value="test" style="width: 340px; margin-bottom: 20px; background-color: rgba(255, 255, 255, 0.06); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(255, 255, 255, 0.15); border-right-color: rgba(255, 255, 255, 0.15); border-top-color: rgba(255, 255, 255, 0.15); border-bottom-color: rgba(255, 255, 255, 0.15); color: rgb(135, 135, 135); font-size: 14px; padding-left: 12px; padding-right: 12px; padding-top: 10px; padding-bottom: 10px;"/>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 0; align-items: center; gap: 10px;">
            <ui:Button text="Join Game" name="JoinButton" style="width: 340px; height: 48px; font-size: 15px; -unity-font-style: bold; background-color: rgba(74, 222, 128, 0.12); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(74, 222, 128, 0.4); border-right-color: rgba(74, 222, 128, 0.4); border-top-color: rgba(74, 222, 128, 0.4); border-bottom-color: rgba(74, 222, 128, 0.4); color: rgb(74, 222, 128); margin-bottom: 0;"/>
            <ui:Button text="Create Game" name="CreateButton" style="width: 340px; height: 48px; font-size: 15px; -unity-font-style: bold; background-color: rgba(255, 255, 255, 0.06); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgba(255, 255, 255, 0.15); border-right-color: rgba(255, 255, 255, 0.15); border-top-color: rgba(255, 255, 255, 0.15); border-bottom-color: rgba(255, 255, 255, 0.15); color: rgb(255, 255, 255); margin-bottom: 0;"/>
            <ui:Button text="How to Play" style="width: 340px; height: 40px; font-size: 13px; background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; color: rgba(255, 255, 255, 0.35);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
