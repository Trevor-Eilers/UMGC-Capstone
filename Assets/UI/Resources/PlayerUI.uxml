    <ui:Template name="TopBarWidget" src="project://database/Assets/UI/Resources/TopBarWidget.uxml?fileID=9197481963319205126&amp;guid=68d7a5bea012eb44895546d04f8f1a83&amp;type=3#TopBarWidget"/>
    <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%; flex-direction: column; align-content: flex-start;">
        <ui:Instance template="TopBarWidget" style="align-self: stretch; flex-shrink: 0; scale: 1 1;"/>
        <ui:VisualElement name="Overlay" style="flex-grow: 1; flex-direction: row; align-items: center; justify-content: space-between;">
            <ui:Instance template="BottomBarWidget" style="flex-shrink: 0; margin-top: 10%; margin-bottom: 10%;"/>
            <ui:VisualElement name="PlayerLabels" style="flex-grow: 1; align-self: stretch; margin-left: 2%; margin-top: 2%; margin-right: 2%; margin-bottom: 2%; flex-shrink: 0; height: auto; width: auto; flex-direction: column;">
                <ui:VisualElement style="flex-grow: 1; flex-direction: row; align-self: auto; justify-content: space-between; align-items: flex-start;">
                    <ui:VisualElement name="P1LabelBox" style="flex-grow: 0; color: rgb(255, 255, 255); background-color: rgba(19, 19, 27, 0.94); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; border-left-color: rgba(19, 19, 27, 0.55); border-right-color: rgba(19, 19, 27, 0.55); border-top-color: rgba(19, 19, 27, 0.55); border-bottom-color: rgba(19, 19, 27, 0.55); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; -unity-text-align: upper-center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; font-size: 12px;">
                        <ui:Label text="Label" name="P1Label" style="color: rgb(255, 255, 255); font-size: 24px; -unity-font-style: bold; padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; background-color: rgba(31, 31, 45, 0.33); margin-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgba(57, 57, 76, 0.54); border-right-color: rgba(57, 57, 76, 0.54); border-top-color: rgba(57, 57, 76, 0.54); border-bottom-color: rgba(57, 57, 76, 0.54);"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="P2LabelBox" style="flex-grow: 0; color: rgb(255, 255, 255); background-color: rgba(19, 19, 27, 0.94); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; border-left-color: rgba(19, 19, 27, 0.55); border-right-color: rgba(19, 19, 27, 0.55); border-top-color: rgba(19, 19, 27, 0.55); border-bottom-color: rgba(19, 19, 27, 0.55); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; -unity-text-align: upper-center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; font-size: 12px;">
                        <ui:Label text="Label" name="P2Label" style="color: rgb(255, 255, 255); font-size: 24px; -unity-font-style: bold; padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; background-color: rgba(31, 31, 45, 0.33); margin-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgba(57, 57, 76, 0.54); border-right-color: rgba(57, 57, 76, 0.54); border-top-color: rgba(57, 57, 76, 0.54); border-bottom-color: rgba(57, 57, 76, 0.54);"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-direction: row; align-self: auto; justify-content: space-between; align-items: flex-end;">
                    <ui:VisualElement name="P3LabelBox" style="flex-grow: 0; color: rgb(255, 255, 255); background-color: rgba(19, 19, 27, 0.94); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; border-left-color: rgba(19, 19, 27, 0.55); border-right-color: rgba(19, 19, 27, 0.55); border-top-color: rgba(19, 19, 27, 0.55); border-bottom-color: rgba(19, 19, 27, 0.55); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; -unity-text-align: upper-center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; font-size: 12px;">
                        <ui:Label text="Label" name="P3Label" style="color: rgb(255, 255, 255); font-size: 24px; -unity-font-style: bold; padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; background-color: rgba(31, 31, 45, 0.33); margin-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgba(57, 57, 76, 0.54); border-right-color: rgba(57, 57, 76, 0.54); border-top-color: rgba(57, 57, 76, 0.54); border-bottom-color: rgba(57, 57, 76, 0.54);"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="P4LabelBox" style="flex-grow: 0; color: rgb(255, 255, 255); background-color: rgba(19, 19, 27, 0.94); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; border-left-color: rgba(19, 19, 27, 0.55); border-right-color: rgba(19, 19, 27, 0.55); border-top-color: rgba(19, 19, 27, 0.55); border-bottom-color: rgba(19, 19, 27, 0.55); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; -unity-text-align: upper-center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; font-size: 12px;">
                        <ui:Label text="Label" name="P4Label" style="color: rgb(255, 255, 255); font-size: 24px; -unity-font-style: bold; padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px; background-color: rgba(31, 31, 45, 0.33); margin-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgba(57, 57, 76, 0.54); border-right-color: rgba(57, 57, 76, 0.54); border-top-color: rgba(57, 57, 76, 0.54); border-bottom-color: rgba(57, 57, 76, 0.54);"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Instance template="PolicyBarWidget" name="TemplateContainer" style="flex-shrink: 0; margin-top: 10%; margin-bottom: 10%;"/>
        </ui:VisualElement>
        <ui:Instance template="HelpOverlay" name="TemplateContainer" picking-mode="Ignore" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; flex-shrink: 0; min-width: 100%; min-height: 100%; align-self: center; display: none;"/>
        <ui:Instance template="EndCardWidget" picking-mode="Ignore" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0;"/>
    </ui:VisualElement>
</ui:UXML>
