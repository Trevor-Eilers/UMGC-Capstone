<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Resources/GameHUD.uss?fileID=7433441132597879392&amp;guid=7bc2dafd71b614848a143c8754ca89c1&amp;type=3#GameHUD"/>
    <ui:VisualElement name="FinancePanel" data-source-type="TopBarViewModel, Assembly-CSharp" style="width: 250px; flex-shrink: 0; flex-direction: column; align-items: stretch; background-color: rgba(17, 17, 24, 0.99); border-right-width: 1px; border-right-color: rgba(255, 255, 255, 0.08); padding-left: 24px; padding-right: 24px; padding-top: 24px; padding-bottom: 24px; border-top-left-radius: 0; border-top-right-radius: 32px; border-bottom-right-radius: 32px; border-bottom-left-radius: 0;">
        <ui:Label text="Finance" style="color: rgb(255, 255, 255); font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 4px; padding-bottom: 8px;"/>
        <ui:VisualElement name="Divider" style="margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>
        <ui:VisualElement name="RevenueRow" class="finance-row">
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between;">
                <ui:Label text="Revenue" class="finance-row-label"/>
                <ui:Label text="i" name="RevenueInfo" tooltip="Tax income this tick. Revenue = (tax rate / 100) × GDP × population × K_REV. A bigger economy and bigger population both boost what each point of tax produces." class="finance-info-icon"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: baseline; justify-content: space-between;">
                <ui:Label text="--" name="RevenueValue" class="finance-row-value">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="Revenue" binding-mode="ToTarget" source-to-ui-converters="CurrencyFormat"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="" name="RevenueDelta" class="finance-row-delta">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="RevenueDelta" binding-mode="ToTarget" source-to-ui-converters="DeltaFormat"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>
        <ui:VisualElement name="SpendingRow" class="finance-row">
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between;">
                <ui:Label text="Spending" class="finance-row-label"/>
                <ui:Label text="i" name="SpendingInfo" tooltip="What you actually paid out this tick. When debt hits the cap (60), spending is throttled down to match revenue automatically — your slider RATIOS are preserved, but every slider operates at the throttle percentage. The &apos;committed&apos; line below shows what your sliders demanded before throttling." class="finance-info-icon"/>
            </ui:VisualElement>
            <ui:Label text="--" name="SpendingValue" class="finance-row-value">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="DeliveredSpending" binding-mode="ToTarget" source-to-ui-converters="CurrencyFormat"/>
                </Bindings>
            </ui:Label>
            <ui:VisualElement style="flex-direction: row; align-items: baseline; justify-content: space-between;">
                <ui:Label text="committed" class="finance-row-sublabel"/>
                <ui:Label text="--" name="CommittedValue" class="finance-row-subvalue">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="CommittedSpending" binding-mode="ToTarget" source-to-ui-converters="CurrencyFormat"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: baseline; justify-content: space-between;">
                <ui:Label text="effectiveness" class="finance-row-sublabel"/>
                <ui:Label text="--" name="EfficiencyValue" class="finance-row-subvalue">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="Efficiency" binding-mode="ToTarget" source-to-ui-converters="OneDecimal"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>
        <ui:VisualElement name="CashFlowRow" class="finance-row">
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between;">
                <ui:Label text="Cash flow / tick" class="finance-row-label"/>
                <ui:Label text="i" name="CashFlowInfo" tooltip="Revenue minus what you committed to spend (NOT the throttled delivery). Negative means you committed more than you can pay — the gap drains reserve first, then accrues debt at K_DEBT_ACCRUAL per dollar. To recover: raise tax (more revenue) or lower a slider (less commitment)." class="finance-info-icon"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: baseline; justify-content: space-between;">
                <ui:Label text="--" name="CashFlowValue" class="finance-row-value">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="CashFlow" binding-mode="ToTarget" source-to-ui-converters="CurrencyFormat"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>
        <ui:VisualElement name="ReserveRow" class="finance-row">
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between;">
                <ui:Label text="Reserve" class="finance-row-label"/>
                <ui:Label text="i" name="ReserveInfo" tooltip="Your savings buffer. Surpluses split: K_DEBT_RECOVERY (33%) pays debt first, the remaining 67% fills reserve. Capped at 22,500. Decays 0.5% per tick (K_RESERVE_DECAY) so you can&apos;t hoard it forever — see the &apos;decay/tick&apos; line below for what&apos;s bleeding off." class="finance-info-icon"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: baseline; justify-content: space-between;">
                <ui:Label text="--" name="ReserveValue" class="finance-row-value">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="Reserve" binding-mode="ToTarget" source-to-ui-converters="CurrencyFormat"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="" name="ReserveDelta" class="finance-row-delta">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="ReserveDelta" binding-mode="ToTarget" source-to-ui-converters="DeltaFormat"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: baseline; justify-content: space-between;">
                <ui:Label text="decay / tick" class="finance-row-sublabel"/>
                <ui:Label text="--" name="ReserveDecayValue" class="finance-row-subvalue">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="ReserveDecayPerTick" binding-mode="ToTarget" source-to-ui-converters="CurrencyFormat"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>
        <ui:VisualElement name="DebtRow" class="finance-row">
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between;">
                <ui:Label text="Debt" class="finance-row-label"/>
                <ui:Label text="i" name="DebtInfo" tooltip="Outstanding debt, range 0-80. Thresholds: 40 → residents get stressed (happiness penalty). 60 → spending throttled to revenue (DEBT_CAP). 70 → federal stabilization fires at K_STABILIZATION_RATE/tick (full rate); 60-69 fires at half rate. Grants enable when debt drops below 60." class="finance-info-icon"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: baseline; justify-content: space-between;">
                <ui:Label text="--" name="DebtValue" class="finance-row-value">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="Debt" binding-mode="ToTarget" source-to-ui-converters="DebtFormat"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="" name="DebtDelta" class="finance-row-delta">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="DebtDelta" binding-mode="ToTarget" source-to-ui-converters="DeltaFormat"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:Label text="cap 60 · stress 40 · stabilization 70" class="finance-row-sublabel"/>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>
        <ui:VisualElement name="GrantsRow" class="finance-row">
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between; margin-top: 4px; margin-bottom: 6px;">
                <ui:Label text="Grants" class="finance-row-label"/>
                <ui:Label text="i" name="GrantsInfo" tooltip="Four federal grants pay bonus revenue while their threshold is met AND debt &lt; 60. Each starts at +$20/tick (GRANT_BASE) and fades 15% per tick on streak (floor 30% = $6). Drop below the threshold and climb back to reset to full strength. Diversify rather than camp on one." class="finance-info-icon"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                <ui:Label text="GRN" name="GrantGreenBadge" tooltip="Green Infrastructure Grant — fires while sustainability &gt; 70 AND debt &lt; 60. Starts at +$20/tick, fades 15%/tick on streak (floor +$6/tick)." class="grant-badge grant-badge-off"/>
                <ui:Label text="TRN" name="GrantTransitBadge" tooltip="Federal Transit Grant — fires while population &gt; 300k AND debt &lt; 60. Starts at +$20/tick, fades 15%/tick on streak (floor +$6/tick)." class="grant-badge grant-badge-off"/>
                <ui:Label text="LIF" name="GrantLifeBadge" tooltip="Quality of Life Grant — fires while happiness &gt; 75 AND debt &lt; 60. Starts at +$20/tick, fades 15%/tick on streak (floor +$6/tick)." class="grant-badge grant-badge-off"/>
                <ui:Label text="DEV" name="GrantDevBadge" tooltip="Development Grant — fires while infrastructure &gt; 80 AND debt &lt; 60. Starts at +$20/tick, fades 15%/tick on streak (floor +$6/tick)." class="grant-badge grant-badge-off"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
