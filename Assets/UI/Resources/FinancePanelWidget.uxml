<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Resources/GameHUD.uss?fileID=7433441132597879392&amp;guid=7bc2dafd71b614848a143c8754ca89c1&amp;type=3#GameHUD"/>
    <ui:VisualElement name="FinancePanel" data-source-type="TopBarViewModel, Assembly-CSharp" style="width: 250px; flex-shrink: 0; flex-direction: column; align-items: stretch; background-color: rgba(17, 17, 24, 0.98); border-right-width: 1px; border-right-color: rgba(255, 255, 255, 0.08); padding-left: 24px; padding-right: 24px; padding-top: 24px; padding-bottom: 24px; border-top-left-radius: 0; border-top-right-radius: 32px; border-bottom-right-radius: 32px; border-bottom-left-radius: 0;">

        <ui:Label text="Finance" style="color: rgb(255, 255, 255); font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 4px; padding-bottom: 8px;"/>
        <ui:VisualElement name="Divider" style="margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>

        <ui:VisualElement name="RevenueRow" class="finance-row">
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between;">
                <ui:Label text="Revenue" class="finance-row-label"/>
                <ui:Label text="i" name="RevenueInfo" tooltip="Tax income this tick. Revenue = tax rate × GDP × population × constant. A bigger economy and bigger population both boost what each point of tax produces." class="finance-info-icon"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: baseline; justify-content: space-between;">
                <ui:Label text="--" name="RevenueValue" class="finance-row-value">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="Revenue" binding-mode="ToTarget" source-to-ui-converters="CurrencyFormat"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="" name="RevenueDelta" class="finance-row-delta">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="RevenueDelta" binding-mode="ToTarget" source-to-ui-converters="DeltaFormat"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>

        <ui:VisualElement name="SpendingRow" class="finance-row">
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between;">
                <ui:Label text="Spending" class="finance-row-label"/>
                <ui:Label text="i" name="SpendingInfo" tooltip="Total money going out this tick, summed across all six sliders (education + infra + housing + env + city contribution). If debt hits the cap, this gets scaled down to match revenue automatically." class="finance-info-icon"/>
            </ui:VisualElement>
            <ui:Label text="--" name="SpendingValue" class="finance-row-value">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="TotalSpending" binding-mode="ToTarget" source-to-ui-converters="CurrencyFormat"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>

        <ui:VisualElement name="BudgetRow" class="finance-row">
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between;">
                <ui:Label text="Budget (tick)" class="finance-row-label"/>
                <ui:Label text="i" name="BudgetInfo" tooltip="Revenue minus Spending, this tick only. Positive means surplus: pays down any debt first, then fills reserve. Negative means deficit: drains reserve first, then grows debt." class="finance-info-icon"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: baseline; justify-content: space-between;">
                <ui:Label text="--" name="BudgetValue" class="finance-row-value">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="BudgetSurplus" binding-mode="ToTarget" source-to-ui-converters="CurrencyFormat"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="" name="BudgetDelta" class="finance-row-delta">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="BudgetSurplusDelta" binding-mode="ToTarget" source-to-ui-converters="DeltaFormat"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>

        <ui:VisualElement name="ReserveRow" class="finance-row">
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between;">
                <ui:Label text="Reserve" class="finance-row-label"/>
                <ui:Label text="i" name="ReserveInfo" tooltip="Your savings account. Fills from surpluses once debt is at zero. Can't grow while you carry any debt. Capped at 22,500 and loses about 0.5% per tick so you can't hoard it forever." class="finance-info-icon"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: baseline; justify-content: space-between;">
                <ui:Label text="--" name="ReserveValue" class="finance-row-value">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="Reserve" binding-mode="ToTarget" source-to-ui-converters="CurrencyFormat"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="" name="ReserveDelta" class="finance-row-delta">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="ReserveDelta" binding-mode="ToTarget" source-to-ui-converters="DeltaFormat"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>

        <ui:VisualElement name="DebtRow" class="finance-row">
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between;">
                <ui:Label text="Debt" class="finance-row-label"/>
                <ui:Label text="i" name="DebtInfo" tooltip="Outstanding debt, 0-80. At 40 residents get stressed (happiness hit). At 60 your spending gets scaled down until you're back in the black. At 70 federal stabilization kicks in but grants lock." class="finance-info-icon"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: baseline; justify-content: space-between;">
                <ui:Label text="--" name="DebtValue" class="finance-row-value">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="Debt" binding-mode="ToTarget" source-to-ui-converters="IndexFormat"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="" name="DebtDelta" class="finance-row-delta">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="DebtDelta" binding-mode="ToTarget" source-to-ui-converters="DeltaFormat"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="margin-top: 4px; margin-bottom: 4px; background-color: rgba(255, 255, 255, 0.04); height: 1px;"/>

        <ui:VisualElement name="GrantsRow" class="finance-row">
            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between; margin-top: 4px; margin-bottom: 6px;">
                <ui:Label text="Grants" class="finance-row-label"/>
                <ui:Label text="i" name="GrantsInfo" tooltip="Four federal grants pay bonus revenue into your Budget each tick they're active. Each starts at +$20/tick and fades 15%/tick you hold it (floor: $6/tick). Drop below the threshold and climb back to reset. Badge lights green while active." class="finance-info-icon"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                <ui:Label text="GRN" name="GrantGreenBadge" tooltip="Green Infrastructure Grant. Active while sustainability &gt; 70. Pays bonus revenue into your Budget — starts at +$20/tick, fades 15% each tick you hold it (floor $6/tick). Drop below 70 and climb back to reset the streak to full strength." class="grant-badge grant-badge-off"/>
                <ui:Label text="TRN" name="GrantTransitBadge" tooltip="Federal Transit Grant. Active while population &gt; 300k. Pays bonus revenue into your Budget — starts at +$20/tick, fades 15% each tick you hold it (floor $6/tick). Lose residents below 300k and grow back to reset." class="grant-badge grant-badge-off"/>
                <ui:Label text="LIF" name="GrantLifeBadge" tooltip="Quality of Life Grant. Active while happiness &gt; 75. Pays bonus revenue into your Budget — starts at +$20/tick, fades 15% each tick you hold it (floor $6/tick). Drop below 75 and climb back to reset." class="grant-badge grant-badge-off"/>
                <ui:Label text="DEV" name="GrantDevBadge" tooltip="Development Grant. Active while infrastructure &gt; 80. Pays bonus revenue into your Budget — starts at +$20/tick, fades 15% each tick you hold it (floor $6/tick). Drop below 80 and climb back to reset." class="grant-badge grant-badge-off"/>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
