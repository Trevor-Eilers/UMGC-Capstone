<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="HelpOverlay" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgb(8, 8, 14); align-items: center; justify-content: center; display: none;">
        <ui:VisualElement name="HelpPanel" style="width: 720px; max-height: 92%; background-color: rgb(23, 23, 32); border-left-color: rgb(64, 64, 77); border-right-color: rgb(64, 64, 77); border-top-color: rgb(64, 64, 77); border-bottom-color: rgb(64, 64, 77); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">

            <ui:VisualElement style="flex-direction: row; align-items: center; justify-content: space-between; padding-top: 20px; padding-right: 24px; padding-bottom: 16px; padding-left: 28px; border-bottom-color: rgb(50, 50, 64); border-bottom-width: 1px;">
                <ui:VisualElement>
                    <ui:Label text="How to Play" style="color: rgb(120, 220, 120); font-size: 22px; -unity-font-style: bold;"/>
                    <ui:Label text="A quick reference for every knob and readout on the HUD." style="color: rgba(200, 200, 200, 0.7); font-size: 11px; margin-top: 2px;"/>
                </ui:VisualElement>
                <ui:Button text="X" name="HelpCloseBtn" style="width: 32px; height: 32px; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; background-color: rgb(46, 46, 58); color: rgb(220, 220, 220); font-size: 14px; -unity-font-style: bold; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
            </ui:VisualElement>

            <ui:ScrollView name="HelpScroll" style="padding-top: 16px; padding-right: 28px; padding-bottom: 20px; padding-left: 28px; flex-grow: 1;">

                <ui:Label text="THE GOAL" style="color: rgba(200, 200, 200, 0.7); font-size: 10px; -unity-font-style: bold; letter-spacing: 2px; margin-bottom: 8px;"/>
                <ui:Label text="You govern one district of a metropolitan city for 48 months (576 ticks, 12 per month). At the end, you get a Final Score. 60% of it measures how your district performed on its own. 40% measures how well the whole city did and whether you pulled your weight on shared projects. Every slider you set trades something for something else — raise taxes and you get more revenue but lose happiness; invest everything locally and your neighbors may end up carrying the metro." style="color: rgb(230, 230, 230); font-size: 12px; white-space: normal; margin-bottom: 20px;"/>

                <ui:Label text="YOUR POLICIES" style="color: rgba(200, 200, 200, 0.7); font-size: 10px; -unity-font-style: bold; letter-spacing: 2px; margin-bottom: 8px;"/>
                <ui:VisualElement name="HelpPolicies"/>

                <ui:Label text="YOUR DISTRICT" style="color: rgba(200, 200, 200, 0.7); font-size: 10px; -unity-font-style: bold; letter-spacing: 2px; margin-top: 16px; margin-bottom: 8px;"/>
                <ui:VisualElement name="HelpDistrict"/>

                <ui:Label text="THE CITY" style="color: rgba(200, 200, 200, 0.7); font-size: 10px; -unity-font-style: bold; letter-spacing: 2px; margin-top: 16px; margin-bottom: 8px;"/>
                <ui:VisualElement name="HelpCity"/>

                <ui:Label text="SCORING" style="color: rgba(200, 200, 200, 0.7); font-size: 10px; -unity-font-style: bold; letter-spacing: 2px; margin-top: 16px; margin-bottom: 8px;"/>
                <ui:Label text="Your Final Score is 60% Neighborhood Score (your own district's GDP, happiness, population, infra, sustainability, and debt) plus 40% City Contribution (city reputation, your share of shared-infra funding, and how well you stayed out of crisis). Playing for your district alone wins you the 60% but leaves the 40% on the table. Playing only for the city wins the 40% but tanks your own metrics. The interesting strategies are somewhere in the middle." style="color: rgb(230, 230, 230); font-size: 12px; white-space: normal; margin-bottom: 12px;"/>

            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
