<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; width: 220px; flex-shrink: 0; flex-direction: column; align-items: stretch; background-color: rgba(10, 14, 26, 0.92); border-left-width: 1px; border-left-color: rgba(255, 255, 255, 0.08); padding-left: 12px; padding-right: 12px; padding-top: 12px; padding-bottom: 12px;">
        <ui:Label text="Policies" style="color: rgb(255, 255, 255); font-size: 11px; -unity-font-style: bold; -unity-text-align: middle-left; margin-bottom: 12px; border-bottom-width: 1px; border-bottom-color: rgba(255, 255, 255, 0.07); padding-bottom: 8px;"/>
        <ui:Slider label="" value="5" high-value="30" name="TaxSlider" show-input-field="false" direction="Horizontal" fill="true" low-value="5" inverted="false" style="width: 100%; margin-left: 0; margin-right: 0; margin-bottom: 14px; flex-shrink: 0; scale: 1 1; flex-direction: row;">
            <ui:Label text="Tax Rate" style="font-size: 11px; color: rgba(255, 255, 255, 0.6); -unity-text-align: middle-left; width: 120px; -unity-font-style: normal;"/>
        </ui:Slider>
        <ui:Slider label="" value="0" high-value="100" name="EduSlider" show-input-field="false" direction="Horizontal" fill="true" style="width: 100%; margin-left: 0; margin-right: 0; margin-bottom: 14px; flex-shrink: 0; scale: 1 1;">
            <ui:Label text="Education" style="font-size: 11px; color: rgba(255, 255, 255, 0.6); -unity-text-align: middle-left; width: 120px; -unity-font-style: normal;"/>
        </ui:Slider>
        <ui:Slider label="" value="0" high-value="100" name="InfraSlider" show-input-field="false" direction="Horizontal" fill="true" style="width: 100%; margin-left: 0; margin-right: 0; margin-bottom: 14px; flex-shrink: 0; scale: 1 1;">
            <ui:Label text="Infrastructure" style="font-size: 11px; color: rgba(255, 255, 255, 0.6); -unity-text-align: middle-left; width: 120px; -unity-font-style: normal;"/>
        </ui:Slider>
        <ui:Slider label="" value="0" high-value="100" name="HousingSlider" show-input-field="false" direction="Horizontal" fill="true" style="width: 100%; margin-left: 0; margin-right: 0; margin-bottom: 14px; flex-shrink: 0; scale: 1 1;">
            <ui:Label text="Housing" style="font-size: 11px; color: rgba(255, 255, 255, 0.6); -unity-text-align: middle-left; width: 120px; -unity-font-style: normal;"/>
        </ui:Slider>
        <ui:Slider label="" value="0" high-value="100" name="EnvSlider" show-input-field="false" direction="Horizontal" fill="true" style="width: 100%; margin-left: 0; margin-right: 0; margin-bottom: 14px; flex-shrink: 0; scale: 1 1;">
            <ui:Label text="Environment" style="font-size: 11px; color: rgba(255, 255, 255, 0.6); -unity-text-align: middle-left; width: 120px; -unity-font-style: normal;"/>
        </ui:Slider>
        <ui:Slider label="" value="0" high-value="50" name="CitySlider" show-input-field="false" direction="Horizontal" fill="true" style="width: 100%; margin-left: 0; margin-right: 0; flex-shrink: 0; scale: 1 1;">
            <ui:Label text="City Contribution" style="font-size: 11px; color: rgba(255, 255, 255, 0.6); -unity-text-align: middle-left; width: 120px; -unity-font-style: normal;"/>
        </ui:Slider>
    </ui:VisualElement>
</ui:UXML>
