<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="GameHUD.uss"/>
    <ui:VisualElement name="PoliciesPanel" style="width: 150px; padding: 6px 8px; background-color: rgba(15, 15, 22, 0.92); flex-shrink: 0; justify-content: space-around;">
        <ui:Label text="Policies" style="color: rgb(230,230,230); font-size: 11px; -unity-font-style: bold; margin-bottom: 4px;"/>

        <!-- Tax Rate -->
        <ui:VisualElement style="margin-bottom: 4px;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                <ui:Label text="Tax Rate" style="color: rgb(166,166,166); font-size: 9px;"/>
                <ui:Label text="15%" name="TaxValue" class="val-tax" style="font-size: 10px; -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:Slider value="15" low-value="5" high-value="30" name="TaxSlider" show-input-field="false" fill="true" class="slider-tax" style="margin: 0;"/>
            <ui:Label text="5 — 30%" style="color: rgb(115,115,115); font-size: 7px;"/>
        </ui:VisualElement>

        <!-- Education -->
        <ui:VisualElement style="margin-bottom: 4px;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                <ui:Label text="Education" style="color: rgb(166,166,166); font-size: 9px;"/>
                <ui:Label text="50" name="EduValue" class="val-edu" style="font-size: 10px; -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:Slider value="50" high-value="100" name="EduSlider" show-input-field="false" fill="true" class="slider-edu" style="margin: 0;"/>
            <ui:Label text="0 — 100" style="color: rgb(115,115,115); font-size: 7px;"/>
        </ui:VisualElement>

        <!-- Infrastructure -->
        <ui:VisualElement style="margin-bottom: 4px;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                <ui:Label text="Infrastructure" style="color: rgb(166,166,166); font-size: 9px;"/>
                <ui:Label text="50" name="InfraValue" class="val-infra" style="font-size: 10px; -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:Slider value="50" high-value="100" name="InfraSlider" show-input-field="false" fill="true" class="slider-infra" style="margin: 0;"/>
            <ui:Label text="0 — 100" style="color: rgb(115,115,115); font-size: 7px;"/>
        </ui:VisualElement>

        <!-- Housing -->
        <ui:VisualElement style="margin-bottom: 4px;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                <ui:Label text="Housing" style="color: rgb(166,166,166); font-size: 9px;"/>
                <ui:Label text="50" name="HousingValue" class="val-house" style="font-size: 10px; -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:Slider value="50" high-value="100" name="HousingSlider" show-input-field="false" fill="true" class="slider-house" style="margin: 0;"/>
            <ui:Label text="0 — 100" style="color: rgb(115,115,115); font-size: 7px;"/>
        </ui:VisualElement>

        <!-- Environment -->
        <ui:VisualElement style="margin-bottom: 4px;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                <ui:Label text="Environment" style="color: rgb(166,166,166); font-size: 9px;"/>
                <ui:Label text="50" name="EnvValue" class="val-env" style="font-size: 10px; -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:Slider value="50" high-value="100" name="EnvSlider" show-input-field="false" fill="true" class="slider-env" style="margin: 0;"/>
            <ui:Label text="0 — 100" style="color: rgb(115,115,115); font-size: 7px;"/>
        </ui:VisualElement>

        <!-- City Contribution -->
        <ui:VisualElement style="margin-bottom: 4px;">
            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                <ui:Label text="City Contrib." style="color: rgb(166,166,166); font-size: 9px;"/>
                <ui:Label text="25" name="CityValue" class="val-city" style="font-size: 10px; -unity-font-style: bold;"/>
            </ui:VisualElement>
            <ui:Slider value="25" high-value="50" name="CitySlider" show-input-field="false" fill="true" class="slider-city" style="margin: 0;"/>
            <ui:Label text="0 — 50" style="color: rgb(115,115,115); font-size: 7px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
