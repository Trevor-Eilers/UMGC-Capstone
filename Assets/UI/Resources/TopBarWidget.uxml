<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="IndicatorBarWidget" src="project://database/Assets/UI/Resources/IndicatorBarWidget.uxml?fileID=9197481963319205126&amp;guid=c78faf8cd7db6f04187519d2260bae67&amp;type=3#IndicatorBarWidget"/>
    <Style src="project://database/Assets/UI/Resources/GameHUD.uss?fileID=7433441132597879392&amp;guid=7bc2dafd71b614848a143c8754ca89c1&amp;type=3#GameHUD"/>
    <ui:VisualElement name="TopBar" style="height: 50px; background-color: rgb(19, 19, 27); flex-direction: row; align-items: center; padding-left: 24px; padding-right: 24px; flex-shrink: 0; justify-content: center; align-self: stretch; align-content: center;">
        <ui:VisualElement style="width: auto; height: 50px; align-items: center; align-self: center; justify-content: flex-start; flex-direction: row;">
            <ui:Label text="CIVIC ENGINE" style="color: rgb(102, 204, 102); font-size: 16px; -unity-font-style: bold; margin-right: 0; flex-shrink: 0; border-left-color: rgb(64, 64, 77); border-right-color: rgb(64, 64, 77); border-top-color: rgb(64, 64, 77); border-bottom-color: rgb(64, 64, 77); border-top-width: 0; border-right-width: 2px; border-bottom-width: 0; border-left-width: 2px; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; margin-top: 2px; padding-right: 8px; padding-top: 4px; padding-bottom: 4px; padding-left: 8px; align-items: flex-start; align-self: auto; margin-left: 0;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="width: 1px; height: 30px; background-color: rgb(64, 64, 77); margin-right: 24px; margin-left: 24px; align-self: auto; align-items: flex-end; justify-content: center; align-content: flex-start;"/>
        <ui:VisualElement name="CityContainer" data-source-type="TopBarViewModel, Assembly-CSharp" style="flex-grow: 0; flex-direction: row; margin-left: 0; margin-right: 0; justify-content: flex-start;">
            <ui:VisualElement style="margin-right: 12px; flex-direction: row; align-items: center;">
                <ui:Label text="Rep" style="color: rgb(134, 134, 134); font-size: 11px; margin-right: 4px;"/>
                <ui:Label text="--" name="CityRepValue" style="color: rgb(232, 217, 64); font-size: 12px; -unity-font-style: bold; margin-right: 4px;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="CityReputation" data-source-type="TopBarViewModel, Assembly-CSharp" binding-mode="ToTarget" source-to-ui-converters="OneDecimal"/>
                    </Bindings>
                </ui:Label>
                <ui:VisualElement style="width: 40px;">
                    <ui:VisualElement class="mini-bar-track" style="width: 40px;">
                        <ui:VisualElement name="CityRepBar" class="mini-bar-fill mini-bar-fill-rep" style="width: 50%;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="margin-right: 12px; flex-direction: row; align-items: center;">
                <ui:Label text="Infra" style="color: rgb(134, 134, 134); font-size: 11px; margin-right: 4px;"/>
                <ui:Label text="--" name="SharedInfraValue" style="color: rgb(97, 128, 224); font-size: 12px; -unity-font-style: bold; margin-right: 4px;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="SharedInfraQuality" binding-mode="ToTarget" source-to-ui-converters="OneDecimal"/>
                    </Bindings>
                </ui:Label>
                <ui:VisualElement style="width: 40px;">
                    <ui:VisualElement class="mini-bar-track" style="width: 40px;">
                        <ui:VisualElement name="SharedInfraBar" class="mini-bar-fill mini-bar-fill-shared" style="width: 50%;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement style="margin-right: 12px; flex-direction: row; align-items: center;">
                <ui:Label text="Metro" style="color: rgb(134, 134, 134); font-size: 11px; margin-right: 4px;"/>
                <ui:Label text="--" name="MetroInflowValue" style="color: rgb(96, 200, 96); font-size: 12px; -unity-font-style: bold;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="MetroInflowPercent" binding-mode="ToTarget" source-to-ui-converters="OneDecimal"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="width: 1px; height: 30px; background-color: rgb(64, 64, 77); margin-right: 24px; margin-left: 24px;"/>
        <ui:VisualElement name="DistrictContainer" style="flex-direction: row; align-items: center; margin-right: 0; flex-shrink: 1; align-self: auto; justify-content: flex-start; align-content: auto;">
            <ui:Instance template="IndicatorBarWidget" style="flex-shrink: 0; margin-left: 0; margin-right: 0; background-color: rgb(25, 25, 36); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(38, 38, 49); border-right-color: rgb(38, 38, 49); border-top-color: rgb(38, 38, 49); border-bottom-color: rgb(38, 38, 49); padding-top: 4px; padding-bottom: 2px; padding-left: 8px; padding-right: 8px; justify-content: center;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="width: 1px; height: 30px; background-color: rgb(64, 64, 77); margin-right: 24px; margin-left: 24px;"/>
        <ui:VisualElement style="flex-grow: 0; justify-content: center; align-items: center; flex-direction: row; align-self: center;">
            <ui:VisualElement name="TimeContainer" data-source-type="TopBarViewModel, Assembly-CSharp" style="margin-right: 8px; margin-left: 8px;">
                <ui:Label text="Month 0 / 48" name="MonthLabel" style="color: rgb(230, 230, 230); font-size: 12px; -unity-font-style: bold; margin-top: 2px; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="MonthDisplay" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="Tick 0 / 576" name="TickLabel" style="color: rgb(115, 115, 115); font-size: 10px; margin-top: 2px; margin-right: 0; margin-bottom: 2px; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="TickDisplay" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement name="TimeControlsContainer" style="flex-direction: row; align-items: center; scale: 1 1; margin-left: 8px; margin-right: 0;">
                <ui:Button text="1x" name="Speed1Btn" class="speed-btn speed-btn-active" style="width: 30px; height: 30px; font-size: 9px;"/>
                <ui:Button text="2x" name="Speed2Btn" class="speed-btn" style="width: 30px; height: 30px; font-size: 9px;"/>
                <ui:Button text="3x" name="Speed3Btn" class="speed-btn" style="width: 30px; height: 30px; font-size: 9px;"/>
                <ui:Button text="||" name="PauseBtn" class="speed-btn" style="width: 30px; height: 30px; font-size: 9px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="width: 1px; height: 30px; background-color: rgb(64, 64, 77); margin-right: 24px; margin-left: 24px; align-self: auto; align-items: flex-end; justify-content: center; align-content: flex-start;"/>
        <ui:Button text="" icon-image="" name="QuitButton" style="align-items: center; align-content: flex-end; width: 35px; height: 35px; justify-content: flex-end; align-self: center; flex-direction: row; flex-shrink: 0; flex-grow: 0; background-color: rgba(188, 188, 188, 0); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-left: 0; margin-right: 0; background-image: url(&quot;project://database/Assets/UI/exit_icon.png?fileID=2800000&amp;guid=21b0a1d46163fce448ee80a22cd7678e&amp;type=3#exit_icon&quot;); background-size: 30px 30px; -unity-background-scale-mode: stretch-to-fill; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgba(250, 144, 133, 0.83); border-right-color: rgba(250, 144, 133, 0.83); border-top-color: rgba(250, 144, 133, 0.83); border-bottom-color: rgba(250, 144, 133, 0.83); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px;"/>
    </ui:VisualElement>
</ui:UXML>
