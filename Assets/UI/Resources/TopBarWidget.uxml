<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="IndicatorBarWidget" src="project://database/Assets/UI/Resources/IndicatorBarWidget.uxml?fileID=9197481963319205126&amp;guid=c78faf8cd7db6f04187519d2260bae67&amp;type=3#IndicatorBarWidget"/>
    <Style src="project://database/Assets/UI/Resources/GameHUD.uss?fileID=7433441132597879392&amp;guid=7bc2dafd71b614848a143c8754ca89c1&amp;type=3#GameHUD"/>
    <ui:VisualElement name="TopBar" style="height: 50px; background-color: rgb(19, 19, 27); flex-direction: row; align-items: center; padding-left: 24px; padding-right: 24px; flex-shrink: 0; justify-content: space-evenly; align-self: stretch; align-content: center; padding-bottom: 2px;">
        <ui:VisualElement style="width: auto; height: 50px; align-items: center; align-self: center; justify-content: flex-start; flex-direction: row; flex-shrink: 0;">
            <ui:Label text="CIVIC ENGINE" style="color: rgb(102, 204, 102); font-size: 16px; -unity-font-style: bold; margin-right: 0; flex-shrink: 0; border-left-color: rgb(64, 64, 77); border-right-color: rgb(64, 64, 77); border-top-color: rgb(64, 64, 77); border-bottom-color: rgb(64, 64, 77); border-top-width: 0; border-right-width: 2px; border-bottom-width: 0; border-left-width: 2px; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; margin-top: 2px; padding-right: 8px; padding-top: 4px; padding-bottom: 4px; padding-left: 8px; align-items: flex-start; align-self: auto; margin-left: 0;"/>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="width: 1px; height: 30px; background-color: rgb(64, 64, 77); margin-right: 24px; margin-left: 24px; align-self: auto; align-items: flex-end; justify-content: center; align-content: flex-start;"/>
        <ui:VisualElement style="flex-grow: 0; flex-direction: row; justify-content: center; align-content: flex-start;">
            <ui:Label text="Metro" style="color: rgba(255, 255, 255, 0.69); -unity-font-style: bold; margin-left: 0; margin-right: 0; width: 60px; -unity-text-align: middle-center;"/>
            <ui:VisualElement name="CityContainer" data-source-type="TopBarViewModel, Assembly-CSharp" style="flex-grow: 1; flex-direction: row; margin-left: 0; margin-right: 0; justify-content: flex-start; -unity-background-image-tint-color: rgb(25, 25, 36); background-color: rgb(25, 25, 36); border-left-color: rgb(38, 38, 49); border-right-color: rgb(38, 38, 49); border-top-color: rgb(38, 38, 49); border-bottom-color: rgb(38, 38, 49); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; height: 45px; align-self: center; align-items: center; flex-shrink: 0;">
                <UI.IndicatorWidget title="Reputation" tooltip="City Reputation (0-100). Weighted average of all districts&apos; happiness, sustainability, infra, GDP, and fiscal health, minus an inequality penalty. Above 70 accelerates population inflow." style="margin-left: 0; margin-right: 0; width: 80px;">
                    <Bindings>
                        <ui:DataBinding property="Value" data-source-path="CityReputation" binding-mode="ToTarget" source-to-ui-converters="IndexFormat"/>
                        <ui:DataBinding property="Delta" data-source-path="CityReputationDelta" binding-mode="ToTarget" source-to-ui-converters="DeltaFormat"/>
                    </Bindings>
                </UI.IndicatorWidget>
                <UI.IndicatorWidget title="Shared Infra" tooltip="Shared metro infrastructure (0-100). Grows when players spend on City Contribution, decays without investment. Enables cross-district commuting once above 25." style="width: 80px;">
                    <Bindings>
                        <ui:DataBinding property="Value" data-source-path="SharedInfraQuality" binding-mode="ToTarget" source-to-ui-converters="IndexFormat"/>
                        <ui:DataBinding property="Delta" data-source-path="SharedInfraQualityDelta" binding-mode="ToTarget" source-to-ui-converters="DeltaFormat"/>
                    </Bindings>
                </UI.IndicatorWidget>
                <UI.IndicatorWidget title="Metro Inflow" tooltip="Population flow into the metro this tick (0-100 scale, 50 = neutral). Above 50 = residents arriving (reputation &gt; 50), below = leaving." style="width: 80px;">
                    <Bindings>
                        <ui:DataBinding property="Value" data-source-path="MetroInflowPercent" binding-mode="ToTarget" source-to-ui-converters="IndexFormat"/>
                    </Bindings>
                </UI.IndicatorWidget>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="width: 1px; height: 30px; background-color: rgb(64, 64, 77); margin-right: 24px; margin-left: 24px;"/>
        <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
            <ui:Label text="District" style="color: rgba(255, 255, 255, 0.69); -unity-font-style: bold; margin-right: 16px; margin-left: 0; width: 60px; -unity-text-align: middle-center;"/>
            <ui:VisualElement name="DistrictContainer" style="flex-direction: row; align-items: center; margin-right: 0; flex-shrink: 1; align-self: auto; justify-content: flex-start; align-content: auto; flex-grow: 1;">
                <ui:Instance template="IndicatorBarWidget" style="flex-shrink: 0; margin-left: 0; margin-right: 0; background-color: rgb(25, 25, 36); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(38, 38, 49); border-right-color: rgb(38, 38, 49); border-top-color: rgb(38, 38, 49); border-bottom-color: rgb(38, 38, 49); padding-top: 4px; padding-bottom: 2px; padding-left: 8px; padding-right: 8px; justify-content: center; flex-grow: 1;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Divider" style="width: 1px; height: 30px; background-color: rgb(64, 64, 77); margin-right: 24px; margin-left: 24px;"/>
        <ui:VisualElement style="flex-grow: 0; justify-content: center; align-items: center; flex-direction: row; align-self: center;">
            <ui:VisualElement name="TimeContainer" data-source-type="TopBarViewModel, Assembly-CSharp" style="margin-right: 8px; margin-left: 8px;">
                <ui:Label text="Month 0 / 48" name="MonthLabel" style="color: rgb(230, 230, 230); font-size: 12px; -unity-font-style: bold; margin-top: 2px; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="MonthDisplay" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="Tick 0 / 576" name="TickLabel" style="color: rgb(115, 115, 115); font-size: 10px; margin-top: 2px; margin-right: 0; margin-bottom: 2px; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="TickDisplay" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement name="TimeControlsContainer" tooltip="Game Speed" style="flex-direction: row; align-items: center; scale: 1 1; margin-left: 8px; margin-right: 0;">
                <ui:Button text="1x" name="Speed1Btn" class="speed-btn" style="width: 30px; height: 30px; font-size: 9px;"/>
                <ui:Button text="2x" name="Speed2Btn" class="speed-btn" style="width: 30px; height: 30px; font-size: 9px;"/>
                <ui:Button text="3x" name="Speed3Btn" class="speed-btn" style="width: 30px; height: 30px; font-size: 9px;"/>
                <ui:Button text="||" name="PauseBtn" class="speed-btn" style="width: 30px; height: 30px; font-size: 9px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="?" name="HelpButton" tooltip="How to Play. Hover anything for a quick explanation, or click here for the full reference." style="width: 32px; height: 32px; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; background-color: rgb(46, 46, 58); color: rgb(220, 220, 220); font-size: 14px; -unity-font-style: bold; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(90, 90, 110); border-right-color: rgb(90, 90, 110); border-top-color: rgb(90, 90, 110); border-bottom-color: rgb(90, 90, 110); margin-left: 16px; margin-right: 0;"/>
        <ui:VisualElement name="Divider" style="width: 1px; height: 30px; background-color: rgb(64, 64, 77); margin-right: 24px; margin-left: 24px; align-self: auto; align-items: flex-end; justify-content: center; align-content: flex-start;"/>
        <ui:Button text="" icon-image="" name="QuitButton" tooltip="Quit Game" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" focusable="false" style="align-items: center; align-content: flex-end; width: 35px; height: 35px; justify-content: flex-end; align-self: center; flex-direction: row; flex-shrink: 0; flex-grow: 0; background-color: rgba(188, 188, 188, 0); padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-left: 0; margin-right: 0; background-image: url(&quot;project://database/Assets/UI/exit_icon.png?fileID=2800000&amp;guid=21b0a1d46163fce448ee80a22cd7678e&amp;type=3#exit_icon&quot;); background-size: 30px 30px; -unity-background-scale-mode: stretch-to-fill; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgba(250, 144, 133, 0.83); border-right-color: rgba(250, 144, 133, 0.83); border-top-color: rgba(250, 144, 133, 0.83); border-bottom-color: rgba(250, 144, 133, 0.83); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px;"/>
    </ui:VisualElement>
</ui:UXML>
