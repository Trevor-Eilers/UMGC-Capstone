.panel-bg {
    background-color: rgba(18, 18, 25, 0.90);
    border-radius: 8px;
}

.top-bar {
    background-color: rgba(13, 13, 20, 0.9);
    height: 36px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 12px;
    padding-right: 8px;
}

.text-title {
    color: rgb(102, 209, 102);
    font-size: 12px;
    -unity-font-style: bold;
}

.text-primary {
    color: rgb(230, 230, 230);
    font-size: 14px;
    -unity-font-style: bold;
}

.text-value {
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-font-style: bold;
}

.text-secondary {
    color: rgb(166, 166, 166);
    font-size: 10px;
}

.text-dim {
    color: rgb(115, 115, 115);
    font-size: 8px;
}

.text-label {
    color: rgb(166, 166, 166);
    font-size: 10px;
}

.section-header {
    color: rgb(230, 230, 230);
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.section-subheader {
    color: rgb(230, 230, 230);
    font-size: 10px;
    -unity-font-style: bold;
    margin-top: 2px;
    margin-bottom: 4px;
}

.bar-track {
    background-color: rgb(46, 46, 56);
    height: 6px;
    border-radius: 3px;
    flex-grow: 1;
}

.bar-fill {
    height: 6px;
    border-radius: 3px;
    position: absolute;
    left: 0;
    top: 0;
}

.bar-fill-gdp {
    background-color: rgb(77, 184, 232);
}

.bar-fill-happy {
    background-color: rgb(232, 192, 48);
}

.bar-fill-pop {
    background-color: rgb(96, 200, 96);
}

.bar-fill-infra {
    background-color: rgb(160, 112, 208);
}

.bar-fill-sustain {
    background-color: rgb(64, 204, 152);
}

.bar-fill-debt {
    background-color: rgb(224, 80, 80);
}

.mini-bar-track {
    background-color: rgb(46, 46, 56);
    height: 5px;
    width: 100px;
    border-radius: 3px;
}

.mini-bar-fill {
    height: 5px;
    border-radius: 3px;
    position: absolute;
    left: 0;
    top: 0;
}

.mini-bar-fill-rep {
    background-color: rgb(232, 217, 64);
}

.mini-bar-fill-shared {
    background-color: rgb(97, 128, 224);
}

.metric-row {
    flex-direction: column;
    margin-bottom: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.metric-label-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 4px;
}

.budget-row {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 2px;
    padding-bottom: 2px;
}

.budget-surplus {
    color: rgb(96, 200, 96);
}

.budget-deficit {
    color: rgb(224, 80, 80);
}

.budget-spend {
    color: rgb(232, 128, 64);
}

.budget-neutral {
    color: rgb(166, 166, 166);
}

.efficiency-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgb(30, 36, 25);
    border-color: rgb(128, 115, 38);
    border-width: 1px;
    border-radius: 4px;
    padding: 3px 8px;
    margin-top: 4px;
}

.grant-badge {
    background-color: rgb(30, 30, 40);
    border-color: rgb(56, 56, 71);
    border-width: 1px;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
}

.grant-badge-active {
    background-color: rgb(25, 38, 30);
    border-color: rgb(64, 204, 152);
}

.grant-icon {
    font-size: 12px;
    margin-bottom: 1px;
}

.grant-name {
    color: rgb(102, 102, 115);
    font-size: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.grant-req {
    color: rgb(84, 84, 97);
    font-size: 6px;
    -unity-text-align: middle-center;
}

.details-button {
    background-color: rgb(40, 40, 56);
    border-color: rgb(77, 77, 97);
    border-width: 1px;
    border-radius: 6px;
    height: 24px;
    margin-top: 6px;
    -unity-text-align: middle-center;
    color: rgb(179, 179, 199);
    font-size: 13px;
    -unity-font-style: bold;
}

.details-button:hover {
    background-color: rgb(50, 50, 66);
}

.details-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(13, 13, 20, 0.75);
    align-items: center;
    justify-content: center;
}

.details-panel {
    width: 500px;
    background-color: rgb(23, 23, 30);
    border-color: rgb(64, 64, 77);
    border-width: 1px;
    border-radius: 16px;
    padding: 24px;
}

.details-row {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 2px;
    padding-bottom: 2px;
}

.close-button {
    position: absolute;
    right: 12px;
    top: 12px;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background-color: rgb(46, 46, 56);
    color: rgb(166, 166, 166);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 0;
}

.divider {
    height: 1px;
    background-color: rgb(51, 51, 64);
    margin-top: 8px;
    margin-bottom: 8px;
}

.speed-btn {
    width: 30px;
    height: 20px;
    border-radius: 4px;
    background-color: rgb(36, 36, 46);
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 0;
    margin-left: 4px;
}

.speed-btn-active {
    background-color: rgb(51, 128, 51);
    border-color: rgb(77, 179, 77);
    border-width: 1px;
}

.slider-tax .unity-base-slider__dragger {
    background-color: rgb(242, 140, 51);
}

.slider-tax .unity-base-slider__fill {
    background-color: rgb(242, 140, 51);
}

.slider-edu .unity-base-slider__dragger {
    background-color: rgb(51, 166, 242);
}

.slider-edu .unity-base-slider__fill {
    background-color: rgb(51, 166, 242);
}

.slider-infra .unity-base-slider__dragger {
    background-color: rgb(217, 102, 166);
}

.slider-infra .unity-base-slider__fill {
    background-color: rgb(217, 102, 166);
}

.slider-house .unity-base-slider__dragger {
    background-color: rgb(179, 217, 51);
}

.slider-house .unity-base-slider__fill {
    background-color: rgb(179, 217, 51);
}

.slider-env .unity-base-slider__dragger {
    background-color: rgb(51, 179, 140);
}

.slider-env .unity-base-slider__fill {
    background-color: rgb(51, 179, 140);
}

.slider-city .unity-base-slider__dragger {
    background-color: rgb(140, 115, 230);
}

.slider-city .unity-base-slider__fill {
    background-color: rgb(140, 115, 230);
}

.finance-row {
    margin-top: 2px;
    margin-bottom: 2px;
    padding-top: 0;
    padding-bottom: 0;
}

.finance-row-label {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
    -unity-text-align: middle-left;
    margin-top: 2px;
    margin-bottom: 0;
    padding: 0;
}

.finance-row-value {
    font-size: 14px;
    color: rgb(230, 230, 230);
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.finance-row-delta {
    font-size: 10px;
    color: rgba(200, 200, 200, 0.7);
    margin: 0;
    padding: 0;
}

.finance-row-sublabel {
    font-size: 10px;
    color: rgba(200, 200, 200, 0.45);
    -unity-font-style: italic;
    margin-left: 8px;
    padding: 0;
}

.finance-row-subvalue {
    font-size: 10px;
    color: rgba(200, 200, 200, 0.55);
    margin: 0;
    padding: 0;
}

.status-ok {
    color: rgb(120, 210, 120);
}

.status-crisis {
    color: rgb(232, 96, 96);
}

.finance-info-icon {
    width: 14px;
    height: 14px;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgba(255, 255, 255, 0.75);
    background-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
}

.grant-badge {
    width: 32px;
    height: 22px;
    -unity-text-align: middle-center;
    font-size: 10px;
    -unity-font-style: bold;
    margin-left: 3px;
    margin-right: 3px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    letter-spacing: 1px;
}

.grant-badge-off {
    background-color: rgb(36, 36, 46);
    color: rgba(200, 200, 200, 0.35);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(64, 64, 77);
    border-right-color: rgb(64, 64, 77);
    border-top-color: rgb(64, 64, 77);
    border-bottom-color: rgb(64, 64, 77);
}

.grant-badge-on {
    background-color: rgb(48, 120, 48);
    color: rgb(230, 255, 230);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(120, 200, 120);
    border-right-color: rgb(120, 200, 120);
    border-top-color: rgb(120, 200, 120);
    border-bottom-color: rgb(120, 200, 120);
}

.val-tax {
    color: rgb(242, 140, 51);
}

.val-edu {
    color: rgb(51, 166, 242);
}

.val-infra {
    color: rgb(217, 102, 166);
}

.val-house {
    color: rgb(179, 217, 51);
}

.val-env {
    color: rgb(51, 179, 140);
}

.val-city {
    color: rgb(140, 115, 230);
}

#unity-text-input {
    background-color: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.6);
}