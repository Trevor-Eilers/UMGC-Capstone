<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="Root" style="background-color: rgb(25, 25, 35); border-radius: 6px; padding: 3px 6px; flex-direction: column;">
        <ui:VisualElement name="LabelRow" style="flex-direction: row; justify-content: space-between; margin-bottom: 2px;">
            <ui:Label text="Label" name="Label" style="color: rgb(166, 166, 166); font-size: 8px;"/>
            <ui:Label text="0" name="IndicatorValue" style="color: rgb(255, 255, 255); font-size: 10px; -unity-font-style: bold;"/>
        </ui:VisualElement>
        <ui:VisualElement name="BarTrack" style="background-color: rgb(46, 46, 56); height: 4px; border-radius: 2px;">
            <ui:VisualElement name="BarFill" style="height: 4px; border-radius: 2px; width: 50%; background-color: rgb(77, 184, 232);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
