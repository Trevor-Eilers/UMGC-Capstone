<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="GameHUD.uss"/>
    <ui:VisualElement name="BottomBar" style="height: 44px; background-color: rgba(13, 13, 20, 0.92); flex-direction: row; align-items: center; padding: 4px 8px; flex-shrink: 0;">

        <!-- 6 Metric Chips -->
        <UI.IndicatorWidget name="GdpIndicator" title="GDP" style="flex-grow: 1; margin-right: 4px;"/>
        <UI.IndicatorWidget name="HappyIndicator" title="Happ." style="flex-grow: 1; margin-right: 4px;"/>
        <UI.IndicatorWidget name="PopIndicator" title="Pop." style="flex-grow: 1; margin-right: 4px;"/>
        <UI.IndicatorWidget name="InfraIndicator" title="Infra." style="flex-grow: 1; margin-right: 4px;"/>
        <UI.IndicatorWidget name="SustainIndicator" title="Sust." style="flex-grow: 1; margin-right: 4px;"/>
        <UI.IndicatorWidget name="DebtIndicator" title="Debt" style="flex-grow: 1; margin-right: 6px;"/>

        <!-- Separator -->
        <ui:VisualElement style="width: 1px; height: 32px; background-color: rgb(64,64,77); margin-right: 6px;"/>

        <!-- Grants + Details -->
        <ui:VisualElement style="flex-direction: column; align-items: center;">
            <ui:VisualElement style="flex-direction: row; margin-bottom: 2px;">
                <ui:VisualElement name="GreenGrant" class="grant-badge" style="width: 20px; height: 20px; margin-right: 2px;">
                    <ui:Label text="🌱" style="font-size: 11px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="TransitGrant" class="grant-badge" style="width: 20px; height: 20px; margin-right: 2px;">
                    <ui:Label text="🚌" style="font-size: 11px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="LifeGrant" class="grant-badge" style="width: 20px; height: 20px; margin-right: 2px;">
                    <ui:Label text="😊" style="font-size: 11px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="DevGrant" class="grant-badge" style="width: 20px; height: 20px;">
                    <ui:Label text="🏗" style="font-size: 11px;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button text="Details ▸" name="DetailsButton" style="height: 14px; font-size: 7px; -unity-font-style: bold; background-color: rgb(40,40,56); border-color: rgb(77,77,97); border-width: 1px; border-radius: 3px; color: rgb(153,153,179); padding: 0 6px;"/>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
